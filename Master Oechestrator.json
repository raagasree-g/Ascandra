{
  "name": "Master Oechestrator",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\n\nconst message =\n  input.message ??\n  input.text ??\n  input.transcript ??\n  \"\";\n\nconst inputType =\n  input.input_type ??\n  input.type ??\n  \"text\";\n\nconst sessionId =\n  input.session_id ??\n  `session_${Date.now()}`;\n\nreturn [\n  {\n    json: {\n      session_id: sessionId,\n      input_type: inputType,\n      user_message: String(message).trim(),\n      received_at: new Date().toISOString()\n    }\n  }\n];"
      },
