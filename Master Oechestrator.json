    {
      "parameters": {
        "jsCode": "const output = $json.text || \"\";\n\nlet cleaned = output.trim();\n\ncleaned = cleaned.replace(/^```json\\s*/i, \"\");\ncleaned = cleaned.replace(/^```\\s*/i, \"\");\ncleaned = cleaned.replace(/\\s*```$/i, \"\");\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  throw new Error(\n    \"Gemini returned invalid JSON. Raw output: \" + output\n  );\n}\n\nreturn [\n  {\n    json: {\n      ...$json,\n      extracted_financial_data: parsed\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        976,
        0
      ],
      "id": "1622407b-a17e-4293-91a8-127d4c3af9cb",
      "name": "Parse Financial Information"
    },
    {
      "parameters": {
        "jsCode": "const data = $json.extracted_financial_data || {};\n\nreturn [\n  {\n    json: {\n      session_id: $json.session_id,\n      input_type: $json.input_type,\n      user_message: $json.user_message,\n\n      business_information: data.business_information || {},\n\n      financial_information: data.financial_information || {},\n\n      credit_information: data.credit_information || {},\n\n      missing_information: data.missing_information || [],\n\n      extraction_confidence: data.confidence || \"LOW\"\n    }\n  }\n];"
      },
